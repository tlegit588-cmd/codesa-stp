{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "codesa-stp",
  "main": "./worker.js",
  "compatibility_date": "2026-11-25",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "codesa-marketplace",
      "database_id": "497ab689-6a96-480d-a11b-8644a163954a"
    }
  ]
}